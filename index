function appendCoachMsg(who, text){
  const thread=document.getElementById("coach-thread");
  const div=document.createElement("div"); div.className="coach-msg "+who; div.textContent=text;
  thread.appendChild(div); thread.scrollTop=thread.scrollHeight;
}
function sendCoachMsg(){
  const input=document.getElementById("coach-input");
  const text=input.value.trim(); if(!text) return;
  input.value=""; askCoach(text);
}
function askCoach(text){
  appendCoachMsg("user", text);
  setTimeout(()=> appendCoachMsg("bot", gerarRespostaCoach(text)), 350);
}
function gerarRespostaCoach(pergunta){
  const p = pergunta.toLowerCase();
  const tot = totaisConsumidosHoje();
  const pesos = [...CACHE.pesos].sort((a,b)=>a.data.localeCompare(b.data));
  const treinosFeitos = CACHE.treinos.filter(t=>t.concluido).length;

  if(p.includes("evolu")){
    if(pesos.length<2) return "Ainda não temos peso suficiente registrado para avaliar sua evolução. Registre seu peso algumas vezes por semana para eu poder te dar uma resposta melhor.";
    const diff = pesos[pesos.length-1].peso - pesos[0].peso;
    return `Desde o início você registrou uma variação de ${diff.toFixed(1)}kg (de ${pesos[0].peso}kg para ${pesos[pesos.length-1].peso}kg), com ${treinosFeitos} treinos concluídos. ${Math.abs(diff)<0.3 && pesos.length>4 ? "O peso está estável — se seu objetivo é mudança de peso, pode valer a pena revisar as calorias consumidas." : "Continue registrando para eu acompanhar a tendência com você."}`;
  }
  if(p.includes("peso não") || p.includes("não está") || p.includes("estagn") || p.includes("platô")){
    return "Isso pode acontecer por vários motivos: metabolismo se ajustando, retenção de líquidos, ou consumo calórico real acima/abaixo do estimado. Vale registrar a alimentação com mais consistência por alguns dias para eu comparar com sua meta. Isso não substitui uma avaliação profissional se a estagnação persistir.";
  }
  if(p.includes("comer hoje") || p.includes("o que posso comer")){
    const rest = Math.max(0, METAS.calorias-tot.kcal);
    const sugestoes = sugerirReceitasParaRestante().map(r=>r.n).join(", ");
    return `Você ainda tem cerca de ${Math.round(rest)} kcal disponíveis hoje. Algumas receitas que se encaixam bem: ${sugestoes}. Dá uma olhada na aba Receitas para ver os detalhes.`;
  }
  if(p.includes("treino faço") || p.includes("qual treino")){
    const t = CACHE.treinos.find(t=>t.data===todayStr());
    return t ? `Hoje é dia de "${t.nome}". Você já concluiu ${t.exercicios.filter(e=>e.concluido).length} de ${t.exercicios.length} exercícios.` : "Não encontrei um treino gerado para hoje — abra a aba Treino para gerar um.";
  }
  if(p.includes("proteína") || p.includes("proteina")){
    const rest = Math.max(0, METAS.proteinas-tot.p);
    return `Você ainda precisa de ${Math.round(rest)}g de proteína hoje para bater sua meta de ${METAS.proteinas}g.`;
  }
  if(p.includes("minha semana") || p.includes("semana")){
    return gerarRelatorioSemanalTexto();
  }
  if(p.includes("receita") && (p.includes("frango") || p.includes("arroz"))){
    const opcoes = RECIPE_DB.filter(r=>r.ing.some(i=>i.toLowerCase().includes("frango")) || r.n.toLowerCase().includes("arroz")).slice(0,3);
    return opcoes.length ? `Com frango e arroz, você pode fazer: ${opcoes.map(o=>o.n).join(", ")}.` : "Não encontrei uma receita exata com esses ingredientes, mas dá uma olhada na aba Receitas.";
  }
  return "Posso te ajudar com perguntas sobre sua evolução, treino do dia, macros restantes ou sugestões de receita. Pode perguntar de outro jeito? Lembrando que não substituo orientação de um profissional de saúde ou educação física.";
}
function gerarRelatorioSemanalTexto(){
  const limite = new Date(); limite.setDate(limite.getDate()-7);
  const pesosSemana = CACHE.pesos.filter(p=>new Date(p.data)>=limite).sort((a,b)=>a.data.localeCompare(b.data));
  const diffPeso = pesosSemana.length>=2 ? (pesosSemana[pesosSemana.length-1].peso-pesosSemana[0].peso) : 0;
  const treinosSemana = CACHE.treinos.filter(t=>new Date(t.data)>=limite);
  const treinosFeitos = treinosSemana.filter(t=>t.concluido).length;
  const refsSemana = CACHE.refeicoes.filter(r=>new Date(r.data)>=limite);
  const diasComRegistro = new Set(refsSemana.map(r=>r.data)).size || 1;
  const kcalMedia = refsSemana.reduce((a,r)=>a+(r.alimentos||[]).reduce((s,f)=>s+f.kcal,0),0)/diasComRegistro;
  const pMedia = refsSemana.reduce((a,r)=>a+(r.alimentos||[]).reduce((s,f)=>s+f.p,0),0)/diasComRegistro;
  return `Resumo dos últimos 7 dias: peso ${diffPeso>=0?'+':''}${diffPeso.toFixed(1)}kg, ${treinosFeitos}/${treinosSemana.length||PROFILE.diasTreino} treinos concluídos, calorias médias ${Math.round(kcalMedia)} (${Math.round(kcalMedia/METAS.calorias*100)}% da meta), proteína média ${Math.round(pMedia)}g (${Math.round(pMedia/METAS.proteinas*100)}% da meta).`;
}

