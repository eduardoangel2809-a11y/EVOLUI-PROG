function gerarTreinoSemana(){
  const dias = PROFILE.diasTreino || 3;
  const split = WORKOUT_SPLITS[dias] || WORKOUT_SPLITS[3];
  const idx = new Date().getDay() % split.length;
  const grupos = split[idx];
  const exercicios = [];
  grupos.forEach(g=>{
    const lista = (EXERCISE_DB[g]||[]).filter(ex=> ex.eq.some(e=> (PROFILE.equipamentos||[]).includes(e) || e==="peso do corpo"));
    const escolhidos = (lista.length?lista:EXERCISE_DB[g]).slice(0,3);
    escolhidos.forEach(ex=> exercicios.push({nome:ex.n, grupo:g, series:ex.s, reps:ex.r, carga:0, descanso:"60-90s", concluido:false, seriesFeitas:0}));
  });
  const nomeTreino = "Treino " + grupos.map(g=>g[0].toUpperCase()+g.slice(1)).join(" + ");
  const treino = { data:todayStr(), nome:nomeTreino, grupos, exercicios, concluido:false };
  db.collection("users").doc(CURRENT_USER.uid).collection("treinos").add(treino).then(ref=>{
    CACHE.treinos.push({id:ref.id, ...treino});
  });
}
