/* ================= EVOLUÇÃO ================= */
let evolPeriodo = 30;
function filtrarPorPeriodo(lista, dias){
  if(dias===0) return lista;
  const limite = new Date(); limite.setDate(limite.getDate()-dias);
  return lista.filter(x=> new Date(x.data) >= limite);
}
function renderEvolucao(){
  const periodos = [["7 dias",7],["30 dias",30],["90 dias",90],["6 meses",180],["1 ano",365],["Tudo",0]];
  const pesos = filtrarPorPeriodo(CACHE.pesos, evolPeriodo).sort((a,b)=>a.data.localeCompare(b.data));
  const todosPesos = CACHE.pesos.length? CACHE.pesos.map(p=>p.peso):[PROFILE.pesoAtual];
  const pesoAtual = todosPesos[todosPesos.length-1];
  const pesoInicial = PROFILE.pesoInicial || todosPesos[0];
  const maiorPeso = Math.max(...todosPesos), menorPeso = Math.min(...todosPesos);
  const diff = pesoAtual - pesoInicial;
  const pctEvol = pesoInicial? (diff/pesoInicial*100):0;

  let html = `<div class="tab-strip">` + periodos.map(p=>`<button class="${evolPeriodo===p[1]?'active':''}" onclick="setEvolPeriodo(${p[1]})">${p[0]}</button>`).join("") + `</div>`;

  html += `<div class="card"><div class="card-title">Peso corporal</div>` + lineChart(pesos.map(p=>({x:p.data, y:p.peso})), "var(--protein)") + `</div>`;

  html += `<div class="grid2" style="margin-top:14px;">
    <div class="stat-card"><div class="big">${pesoInicial} kg</div><div class="sub">Peso inicial</div></div>
    <div class="stat-card"><div class="big">${pesoAtual} kg</div><div class="sub">Peso atual</div></div>
    <div class="stat-card"><div class="big">${maiorPeso} kg</div><div class="sub">Maior peso</div></div>
    <div class="stat-card"><div class="big">${menorPeso} kg</div><div class="sub">Menor peso</div></div>
    <div class="stat-card"><div class="big" style="color:${diff<=0?'var(--protein)':'var(--energy)'}">${diff>0?'+':''}${diff.toFixed(1)} kg</div><div class="sub">Diferença total</div></div>
    <div class="stat-card"><div class="big">${pctEvol.toFixed(1)}%</div><div class="sub">Evolução percentual</div></div>
  </div>`;

  const kcalHist = filtrarPorPeriodo(diarioAgregadoPorDia(), evolPeriodo);
  html += `<div class="card" style="margin-top:14px;"><div class="card-title">Calorias diárias</div>` + lineChart(kcalHist.map(d=>({x:d.data, y:d.kcal})), "var(--energy)") + `</div>`;

  html += `<div class="section-title">Medidas corporais</div>
    <button class="btn btn-ghost btn-block" onclick="openOverlay('measure-overlay')">+ registrar medidas</button>`;
  const ultimaMedida = CACHE.medidas[CACHE.medidas.length-1];
  if(ultimaMedida){
    html += `<div class="card" style="margin-top:10px;">
      <div class="card-title">Última medição — ${fmtDateBR(ultimaMedida.data)}</div>
      <div class="grid2">
        ${["braco","peito","cintura","abdomen","quadril","coxa","panturrilha"].map(k=>`<div class="stat-card"><div class="big">${ultimaMedida[k]||'-'} cm</div><div class="sub">${k}</div></div>`).join("")}
      </div>
    </div>`;
  }

  html += `<div class="section-title">Fotos de evolução</div>
    <div class="grid2" style="grid-template-columns:1fr 1fr 1fr; gap:8px;">
      ${["frente","lado","costas"].map(tipo=>{
