/* ================= HELPERS GERAIS ================= */
function todayStr(){ return new Date().toISOString().slice(0,10); }
function fmtDateBR(iso){ const [y,m,d]=iso.split("-"); return `${d}/${m}/${y}`; }
function showToast(msg){
  const t=document.getElementById("toast"); t.textContent=msg; t.classList.add("show");
  setTimeout(()=>t.classList.remove("show"), 2200);
}
function openOverlay(id){ document.getElementById(id).classList.add("active"); }
function closeOverlay(id){ document.getElementById(id).classList.remove("active"); }
function openModal(id){ document.getElementById(id).classList.add("active"); }
function closeModal(id){ document.getElementById(id).classList.remove("active"); }
function pesoVariacaoAbs(pesos){ if(pesos.length<2) return 0; const ord=[...pesos].sort((a,b)=>a.data.localeCompare(b.data)); return Math.abs(ord[ord.length-1].peso-ord[0].peso); }
function totalRefeicoesRegistradas(refeicoes){ return refeicoes.reduce((acc,r)=>acc+(r.alimentos?r.alimentos.length:0),0); }
function checarProgressaoCarga(treinos){
  const cargas={};
  for(const t of treinos.sort((a,b)=>a.data.localeCompare(b.data))){
    for(const ex of (t.exercicios||[])){
      if(cargas[ex.nome]!==undefined && ex.carga>cargas[ex.nome]) return true;
      cargas[ex.nome]=ex.carga;
    }
  }
  return false;
}

