  openOverlay("foodphoto-overlay");
}
function fileToBase64(file){
  return new Promise((resolve,reject)=>{
    const reader = new FileReader();
    reader.onload = ()=> resolve(reader.result.split(",")[1]);
    reader.onerror = reject;
    reader.readAsDataURL(file);
  });
}
async function handleFoodPhoto(e){
  if(!e.target.files.length) return;
  const file = e.target.files[0];
  document.getElementById("foodphoto-result").classList.add("hidden");
  document.getElementById("foodphoto-error").classList.add("hidden");
  document.getElementById("foodphoto-loading").classList.remove("hidden");
  try{
    const imageBase64 = await fileToBase64(file);
    const resp = await fetch(FOOD_PHOTO_FUNCTION_URL, {
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body: JSON.stringify({ imageBase64, mediaType: file.type || "image/jpeg" })
    });
    if(!resp.ok) throw new Error("Falha na análise");
    const data = await resp.json();
    document.getElementById("foodphoto-name").value = data.nome || "Prato identificado";
    document.getElementById("foodphoto-kcal").value = Math.round(data.kcal||0);
    document.getElementById("foodphoto-p").value = Math.round(data.proteinas||0);
    document.getElementById("foodphoto-c").value = Math.round(data.carboidratos||0);
    document.getElementById("foodphoto-f").value = Math.round(data.gorduras||0);
    document.getElementById("foodphoto-itens").textContent = (data.itens||[]).map(i=> (i.alimento||i)+(i.porcao?` (${i.porcao})`:"")).join(", ");
    document.getElementById("foodphoto-result").classList.remove("hidden");
  }catch(err){
    console.error(err);
    document.getElementById("foodphoto-error").classList.remove("hidden");
  }finally{
    document.getElementById("foodphoto-loading").classList.add("hidden");
  }
}
function confirmAddFoodPhoto(){
  const tipo=document.getElementById("foodphoto-meal").value;
  const item = { nome:document.getElementById("foodphoto-name").value||"Refeição por foto", qtd:1,
