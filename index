function totaisConsumidosHoje(){
  const hoje = CACHE.refeicoes.filter(r=>r.data===todayStr());
  let kcal=0,p=0,c=0,f=0;
  hoje.forEach(r=> (r.alimentos||[]).forEach(a=>{ kcal+=a.kcal; p+=a.p; c+=a.c; f+=a.f; }));
  return {kcal,p,c,f};
}
function streakTreino(){
  const dias = new Set(CACHE.treinos.filter(t=>t.concluido).map(t=>t.data));
  let streak=0, d=new Date();
  while(true){ const iso=d.toISOString().slice(0,10); if(dias.has(iso)){ streak++; d.setDate(d.getDate()-1); } else break; }
  return streak;
}
function ring(cx, r, pct, color, strokeW){
  const c=2*Math.PI*r;
  const off = c - Math.min(pct,1)*c;
  return `<circle cx="95" cy="95" r="${r}" fill="none" stroke="${color}" stroke-opacity="0.15" stroke-width="${strokeW}"/>
  <circle cx="95" cy="95" r="${r}" fill="none" stroke="${color}" stroke-width="${strokeW}" stroke-linecap="round"
   stroke-dasharray="${c}" stroke-dashoffset="${off}" transform="rotate(-90 95 95)"/>`;
}
