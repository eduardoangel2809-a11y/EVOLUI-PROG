/* ================= AI COACH (baseado em regras sobre os dados registrados) ================= */
const COACH_SUGGESTIONS = ["Estou evoluindo?","Por que meu peso não está mudando?","O que posso comer hoje?","Qual treino faço hoje?","Quanto de proteína ainda preciso?","Como foi minha semana?"];
function openCoach(){
  document.getElementById("coach-suggest").innerHTML = COACH_SUGGESTIONS.map(s=>`<button onclick="askCoach('${s.replace(/'/g,"\\'")}')">${s}</button>`).join("");
  if(!document.getElementById("coach-thread").innerHTML){
    appendCoachMsg("bot", `Oi, ${(PROFILE.nome||"").split(" ")[0]}! Posso te ajudar com base no que você já registrou. Toque em uma sugestão ou digite sua pergunta.`);
  }
