        </button>`;
      }).join("")}
    </div>
    <button class="btn btn-ghost btn-block" style="margin-top:10px;" onclick="openCompareOverlay()">Comparar antes × depois</button>`;

  html += `<div class="section-title">Conquistas</div><div class="grid2">`;
  ACHIEVEMENTS.forEach(a=>{
    const unlocked = !!CACHE.conquistas[a.id];
    html += `<div class="stat-card"><div class="badge ${unlocked?'badge-unlock':'badge-lock'}">${unlocked?'✓ Conquistado':'Bloqueado'}</div><div style="font-weight:700; font-size:13px; margin-top:8px;">${a.nome}</div><div class="sub">${a.desc}</div></div>`;
  });
  html += `</div>`;

  document.getElementById("evolucao-content").innerHTML = html;
}
function setEvolPeriodo(d){ evolPeriodo=d; renderEvolucao(); }
function diarioAgregadoPorDia(){
  const map={};
  CACHE.refeicoes.forEach(r=>{
    map[r.data]=map[r.data]||0;
    (r.alimentos||[]).forEach(a=> map[r.data]+=a.kcal);
  });
  return Object.keys(map).sort().map(d=>({data:d, kcal:Math.round(map[d])}));
}
function lineChart(points, color){
  if(!points.length) return `<div class="empty-state" style="padding:30px 0;"><div class="ic">📉</div>Sem dados suficientes ainda neste período.</div>`;
  const w=380, h=140, pad=10;
  const ys = points.map(p=>p.y);
  const minY = Math.min(...ys), maxY = Math.max(...ys);
  const range = (maxY-minY)||1;
  const stepX = points.length>1 ? (w-2*pad)/(points.length-1) : 0;
  const coords = points.map((p,i)=>{
    const x = pad + i*stepX;
    const y = h-pad - ((p.y-minY)/range)*(h-2*pad);
    return [x,y];
  });
  const path = coords.map((c,i)=> (i===0?"M":"L")+c[0].toFixed(1)+","+c[1].toFixed(1)).join(" ");
  const area = path + ` L${coords[coords.length-1][0].toFixed(1)},${h-pad} L${coords[0][0].toFixed(1)},${h-pad} Z`;
  return `<svg width="100%" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none">
    <path d="${area}" fill="${color}" opacity="0.12"></path>
    <path d="${path}" fill="none" stroke="${color}" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"></path>
    ${coords.map(c=>`<circle cx="${c[0].toFixed(1)}" cy="${c[1].toFixed(1)}" r="3" fill="${color}"></circle>`).join("")}
  </svg>`;
}

