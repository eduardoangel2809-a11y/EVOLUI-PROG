/* ================= CÁLCULOS: TMB / TDEE / MACROS ================= */
function idadeAnos(nasc){
  const d=new Date(nasc), hoje=new Date();
  let idade=hoje.getFullYear()-d.getFullYear();
  const m=hoje.getMonth()-d.getMonth();
  if(m<0 || (m===0 && hoje.getDate()<d.getDate())) idade--;
  return idade;
}
function calcularBMR(profile){
  const idade=idadeAnos(profile.dataNascimento);
  const base = 10*profile.pesoAtual + 6.25*profile.altura - 5*idade;
  return profile.sexo==="masculino" ? base+5 : base-161;
}
const FATOR_ATIVIDADE = {sedentario:1.2, leve:1.375, moderado:1.55, intenso:1.725, muito_intenso:1.9};
function calcularMetas(profile){
  const bmr = calcularBMR(profile);
  const tdee = bmr * (FATOR_ATIVIDADE[profile.nivelAtividade]||1.375);
  let ajuste=0;
  if(["emagrecimento","perda_gordura"].includes(profile.objetivo)) ajuste=-0.20;
  else if(profile.objetivo==="recomposicao") ajuste=-0.10;
  else if(["ganho_massa","hipertrofia"].includes(profile.objetivo)) ajuste=0.12;
  else ajuste=0;
  const calorias = Math.round(tdee*(1+ajuste));
  const proteinas = Math.round(profile.pesoAtual * (profile.proteinaPorKg||1.8));
  const gorduraKcal = calorias*0.25;
  const gorduras = Math.round(gorduraKcal/9);
  const carbKcal = calorias - (proteinas*4) - gorduraKcal;
  const carboidratos = Math.max(0, Math.round(carbKcal/4));
  return { bmr:Math.round(bmr), tdee:Math.round(tdee), calorias, proteinas, carboidratos, gorduras, agua: Math.round(profile.pesoAtual*35) };
}

