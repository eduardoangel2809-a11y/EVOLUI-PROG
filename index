<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Evoluir — Treino, Nutrição e Evolução</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0E0F13; --bg-elev:#15171F; --bg-card:#1B1D28; --bg-card-2:#20222F;
  --border:#2A2D3A; --border-soft:#22242F;
  --text:#F2F1ED; --text-muted:#8B8D9B; --text-dim:#5C5F6E;
  --energy:#FF8A3D; --protein:#3DDC97; --carb:#5EA8FF; --fat:#E0629E;
  --danger:#FF5C5C; --ok:#3DDC97;
  --radius-l:22px; --radius-m:16px; --radius-s:10px;
  --font-display:'Space Grotesk',sans-serif; --font-body:'Inter',sans-serif; --font-mono:'JetBrains Mono',monospace;
}
*{box-sizing:border-box; margin:0; padding:0;}
html,body{height:100%;}
body{
  background:var(--bg); color:var(--text); font-family:var(--font-body);
  -webkit-font-smoothing:antialiased; overscroll-behavior:none;
}
::-webkit-scrollbar{width:0;height:0;}
button{font-family:inherit; cursor:pointer; border:none; background:none; color:inherit;}
input,select,textarea{font-family:inherit; color:var(--text); background:var(--bg-card-2); border:1px solid var(--border); border-radius:var(--radius-s); padding:12px 14px; font-size:15px; width:100%;}
input:focus,select:focus,textarea:focus{outline:none; border-color:var(--protein);}
h1,h2,h3,.display{font-family:var(--font-display);}
.mono{font-family:var(--font-mono);}
a{color:var(--protein);}

#phone{
  max-width:460px; min-height:100vh; margin:0 auto; position:relative;
  background:linear-gradient(180deg,#0E0F13 0%,#0B0C10 100%);
  display:flex; flex-direction:column;
}
.screen{display:none; flex:1; flex-direction:column; padding-bottom:96px;}
.screen.active{display:flex;}
.hidden{display:none !important;}

/* ---------- Auth ---------- */
#auth-screen{justify-content:center; padding:32px 28px; min-height:100vh;}
.brand{display:flex; align-items:center; gap:10px; margin-bottom:44px;}
.brand-mark{width:38px; height:38px; border-radius:11px; background:conic-gradient(from 220deg, var(--energy), var(--protein), var(--carb), var(--fat), var(--energy)); flex-shrink:0;}
.brand-name{font-size:20px; font-weight:700; letter-spacing:-0.02em;}
.auth-title{font-size:30px; font-weight:700; letter-spacing:-0.03em; line-height:1.15; margin-bottom:8px;}
.auth-sub{color:var(--text-muted); font-size:14.5px; margin-bottom:32px; line-height:1.5;}
.field{margin-bottom:14px;}
.field label{display:block; font-size:12.5px; color:var(--text-muted); margin-bottom:6px; font-weight:500;}
.btn{
  display:flex; align-items:center; justify-content:center; gap:8px;
  border-radius:var(--radius-s); padding:14px 18px; font-weight:600; font-size:15px;
  transition:transform .15s ease, opacity .15s ease;
}
.btn:active{transform:scale(.97);}
.btn-primary{background:var(--text); color:#101116;}
.btn-primary:disabled{opacity:.4;}
.btn-ghost{background:transparent; color:var(--text-muted); border:1px solid var(--border);}
.btn-accent{background:var(--protein); color:#082019;}
.btn-block{width:100%;}
.auth-actions{display:flex; flex-direction:column; gap:10px; margin-top:22px;}
.auth-switch{text-align:center; margin-top:24px; font-size:13.5px; color:var(--text-muted);}
.auth-switch button{color:var(--protein); font-weight:600;}
.error-msg{background:rgba(255,92,92,.1); border:1px solid rgba(255,92,92,.3); color:#ff8f8f; font-size:13px; padding:10px 12px; border-radius:var(--radius-s); margin-bottom:14px;}

/* ---------- Header / Content ---------- */
.app-header{
  display:flex; align-items:center; justify-content:space-between;
  padding:20px 20px 14px; position:sticky; top:0; z-index:5;
  background:linear-gradient(180deg,#0E0F13 80%,transparent);
}
.header-greet .eyebrow{font-size:11.5px; color:var(--text-dim); text-transform:uppercase; letter-spacing:.08em; font-weight:600;}
.header-greet h1{font-size:21px; margin-top:2px;}
.header-icons{display:flex; gap:8px;}
.icon-btn{
  width:38px; height:38px; border-radius:12px; background:var(--bg-card);
  border:1px solid var(--border-soft); display:flex; align-items:center; justify-content:center;
  font-size:16px;
}
.streak-pill{
  display:flex; align-items:center; gap:5px; background:var(--bg-card); border:1px solid var(--border-soft);
  padding:5px 10px 5px 8px; border-radius:100px; font-size:12.5px; font-weight:600; color:var(--energy);
}
.content{padding:6px 20px 20px; flex:1; overflow-y:auto;}

/* ---------- Cards ---------- */
.card{background:var(--bg-card); border:1px solid var(--border-soft); border-radius:var(--radius-l); padding:18px;}
.card + .card{margin-top:14px;}
.card-title{font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--text-muted); margin-bottom:12px;}
.section-title{font-size:18px; font-weight:700; letter-spacing:-0.01em; margin:22px 0 12px;}
.section-title:first-child{margin-top:0;}

/* ---------- Rings (signature element) ---------- */
.ring-wrap{position:relative; width:190px; height:190px; margin:6px auto 8px;}
.ring-center{position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center;}
.ring-center .kcal-num{font-family:var(--font-mono); font-size:30px; font-weight:700; letter-spacing:-0.02em;}
.ring-center .kcal-lbl{font-size:11px; color:var(--text-muted); margin-top:2px; text-align:center;}
.macro-legend{display:flex; justify-content:space-between; gap:8px; margin-top:14px;}
.macro-item{flex:1; text-align:center;}
.macro-dot{width:8px; height:8px; border-radius:50%; display:inline-block; margin-right:5px;}
.macro-item .val{font-family:var(--font-mono); font-weight:700; font-size:14px; display:block; margin-top:4px;}
.macro-item .lbl{font-size:10.5px; color:var(--text-dim); text-transform:uppercase; letter-spacing:.04em;}

/* ---------- Progress bars ---------- */
.pbar{height:8px; border-radius:100px; background:var(--bg-card-2); overflow:hidden;}
.pbar > div{height:100%; border-radius:100px; transition:width .4s ease;}
.stat-row{display:flex; justify-content:space-between; align-items:baseline; margin-bottom:6px; font-size:12.5px;}
.stat-row .lbl{color:var(--text-muted); font-weight:500;}
.stat-row .val{font-family:var(--font-mono); font-weight:600;}

/* ---------- Grid stats ---------- */
.grid2{display:grid; grid-template-columns:1fr 1fr; gap:12px;}
.stat-card{background:var(--bg-card); border:1px solid var(--border-soft); border-radius:var(--radius-m); padding:14px;}
.stat-card .big{font-family:var(--font-mono); font-size:22px; font-weight:700;}
.stat-card .sub{font-size:11.5px; color:var(--text-muted); margin-top:2px;}

/* ---------- Bottom nav ---------- */
#bottom-nav{
  position:fixed; left:50%; transform:translateX(-50%); bottom:16px; width:calc(100% - 32px); max-width:428px;
  background:rgba(27,29,40,.92); backdrop-filter:blur(14px); border:1px solid var(--border-soft);
  border-radius:24px; display:flex; align-items:center; justify-content:space-around; padding:8px 6px; z-index:20;
}
.nav-item{display:flex; flex-direction:column; align-items:center; gap:3px; padding:6px 8px; border-radius:14px; color:var(--text-dim); font-size:9.5px; font-weight:600; letter-spacing:.02em;}
.nav-item .ic{font-size:18px;}
.nav-item.active{color:var(--text);}
.nav-fab{
  width:52px; height:52px; border-radius:16px; background:var(--protein); color:#082019;
  display:flex; align-items:center; justify-content:center; font-size:24px; font-weight:700; margin-top:-26px;
  box-shadow:0 8px 20px rgba(61,220,151,.35);
}

/* ---------- Sheets / Modals ---------- */
.overlay{position:fixed; inset:0; background:rgba(6,7,10,.65); z-index:40; display:none; align-items:flex-end;}
.overlay.active{display:flex;}
.sheet{
  width:100%; max-width:460px; margin:0 auto; background:var(--bg-elev); border-radius:26px 26px 0 0;
  padding:10px 20px 28px; max-height:86vh; overflow-y:auto; border:1px solid var(--border-soft); border-bottom:none;
}
.sheet-handle{width:36px; height:4px; background:var(--border); border-radius:100px; margin:6px auto 16px;}
.sheet-title{font-size:19px; font-weight:700; margin-bottom:4px;}
.sheet-sub{font-size:13px; color:var(--text-muted); margin-bottom:18px;}
.close-x{position:absolute; top:16px; right:18px; font-size:20px; color:var(--text-muted);}

.modal-overlay{position:fixed; inset:0; background:rgba(6,7,10,.7); z-index:50; display:none; align-items:center; justify-content:center; padding:20px;}
.modal-overlay.active{display:flex;}
.modal-box{width:100%; max-width:420px; background:var(--bg-elev); border:1px solid var(--border-soft); border-radius:var(--radius-l); padding:22px; max-height:85vh; overflow-y:auto;}

/* ---------- Chips ---------- */
.chip-row{display:flex; flex-wrap:wrap; gap:8px;}
.chip{
  padding:9px 14px; border-radius:100px; background:var(--bg-card-2); border:1px solid var(--border);
  font-size:13px; font-weight:500; color:var(--text-muted);
}
.chip.selected{background:var(--protein); color:#082019; border-color:var(--protein); font-weight:600;}

/* ---------- Exercise / list rows ---------- */
.exercise-card{background:var(--bg-card); border:1px solid var(--border-soft); border-radius:var(--radius-m); padding:15px; margin-bottom:10px;}
.exercise-head{display:flex; justify-content:space-between; align-items:flex-start;}
.exercise-name{font-weight:700; font-size:15.5px;}
.exercise-meta{font-size:12px; color:var(--text-muted); margin-top:3px;}
.set-row{display:flex; align-items:center; gap:8px; margin-top:10px;}
.set-check{width:30px; height:30px; border-radius:9px; border:1.5px solid var(--border); display:flex; align-items:center; justify-content:center; font-size:14px; color:var(--text-dim); flex-shrink:0;}
.set-check.done{background:var(--protein); border-color:var(--protein); color:#082019;}
.set-inputs{display:flex; gap:6px; flex:1;}
.set-inputs input{padding:8px 8px; font-size:13px; text-align:center;}

.meal-block{margin-bottom:16px;}
.meal-head{display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;}
.meal-head h3{font-size:15px;}
.meal-kcal{font-family:var(--font-mono); font-size:12.5px; color:var(--text-muted);}
.food-row{display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid var(--border-soft); font-size:13.5px;}
.food-row:last-child{border-bottom:none;}
.food-name{font-weight:600;}
.food-sub{font-size:11.5px; color:var(--text-muted); margin-top:2px;}
.food-kcal{font-family:var(--font-mono); font-weight:600; color:var(--energy); font-size:13px;}
.add-mini{width:100%; text-align:center; padding:9px; border:1px dashed var(--border); border-radius:var(--radius-s); font-size:12.5px; color:var(--text-muted); margin-top:6px;}

.recipe-card{background:var(--bg-card); border:1px solid var(--border-soft); border-radius:var(--radius-m); overflow:hidden; margin-bottom:12px;}
.recipe-photo{height:110px; display:flex; align-items:center; justify-content:center; font-size:34px;}
.recipe-body{padding:14px;}
.recipe-name{font-weight:700; font-size:15px;}
.recipe-tags{font-size:11.5px; color:var(--text-muted); margin-top:3px;}
.recipe-macros{display:flex; gap:12px; margin-top:10px; font-size:11.5px; font-family:var(--font-mono);}

/* ---------- Onboarding ---------- */
#onboarding-screen{padding:0;}
.ob-progress{display:flex; gap:5px; padding:18px 20px 0;}
.ob-progress > div{flex:1; height:3px; border-radius:100px; background:var(--border-soft);}
.ob-progress > div.done{background:var(--protein);}
.ob-body{padding:24px 24px 100px; flex:1; overflow-y:auto;}
.ob-step-title{font-size:23px; font-weight:700; letter-spacing:-0.02em; margin-bottom:6px;}
.ob-step-sub{font-size:13.5px; color:var(--text-muted); margin-bottom:24px; line-height:1.5;}
.ob-footer{position:fixed; bottom:0; left:0; right:0; padding:16px 24px 24px; max-width:460px; margin:0 auto; background:linear-gradient(0deg,#0E0F13 70%,transparent);}
.ob-nav{display:flex; gap:10px;}

.tab-strip{display:flex; gap:6px; margin-bottom:16px; overflow-x:auto; padding-bottom:2px;}
.tab-strip button{padding:8px 14px; border-radius:100px; background:var(--bg-card); border:1px solid var(--border-soft); font-size:12.5px; font-weight:600; color:var(--text-muted); white-space:nowrap;}
.tab-strip button.active{background:var(--text); color:#101116;}

.empty-state{text-align:center; padding:32px 16px; color:var(--text-muted); font-size:13.5px;}
.empty-state .ic{font-size:30px; margin-bottom:8px;}

.badge{display:inline-flex; align-items:center; gap:5px; padding:4px 9px; border-radius:100px; font-size:10.5px; font-weight:700;}
.badge-lock{background:var(--bg-card-2); color:var(--text-dim);}
.badge-unlock{background:rgba(61,220,151,.15); color:var(--protein);}

.disclaimer{font-size:11.5px; color:var(--text-dim); line-height:1.6; background:var(--bg-card); border:1px solid var(--border-soft); border-radius:var(--radius-m); padding:14px;}

.coach-msg{max-width:85%; padding:11px 14px; border-radius:16px; font-size:13.5px; line-height:1.5; margin-bottom:10px;}
.coach-msg.bot{background:var(--bg-card); border:1px solid var(--border-soft); border-bottom-left-radius:4px;}
.coach-msg.user{background:var(--protein); color:#082019; margin-left:auto; border-bottom-right-radius:4px; font-weight:500;}
.coach-suggest{display:flex; gap:6px; overflow-x:auto; margin-bottom:12px; padding-bottom:2px;}
.coach-suggest button{white-space:nowrap; font-size:12px; padding:8px 12px; border-radius:100px; background:var(--bg-card); border:1px solid var(--border-soft); color:var(--text-muted);}

.toast{position:fixed; bottom:110px; left:50%; transform:translateX(-50%); background:var(--text); color:#101116; padding:11px 18px; border-radius:100px; font-size:13px; font-weight:600; z-index:60; box-shadow:0 8px 24px rgba(0,0,0,.4); opacity:0; transition:opacity .25s ease, transform .25s ease;}
.toast.show{opacity:1;}

@media (prefers-reduced-motion:reduce){*{transition:none !important; animation:none !important;}}
</style>
</head>
<body>

<div id="phone">

  <!-- ================= AUTH ================= -->
  <div id="auth-screen" class="screen active">
    <div class="brand"><div class="brand-mark"></div><div class="brand-name">Evoluir</div></div>

    <div id="login-view">
      <div class="auth-title">Bem-vindo de volta</div>
      <div class="auth-sub">Entre para continuar acompanhando seu treino, alimentação e evolução.</div>
      <div id="login-error"></div>
      <div class="field"><label>E-mail</label><input type="email" id="login-email" placeholder="voce@email.com"></div>
      <div class="field"><label>Senha</label><input type="password" id="login-pass" placeholder="••••••••"></div>
      <div class="auth-actions">
        <button class="btn btn-primary btn-block" onclick="doLogin()">Entrar</button>
        <button class="btn btn-ghost btn-block" onclick="showView('forgot')">Esqueci minha senha</button>
      </div>
      <div class="auth-switch">Ainda não tem conta? <button onclick="showView('signup')">Criar conta</button></div>
    </div>

    <div id="signup-view" class="hidden">
      <div class="auth-title">Crie sua conta</div>
      <div class="auth-sub">Leva menos de um minuto. Depois vamos te conhecer melhor.</div>
      <div id="signup-error"></div>
      <div class="field"><label>Nome</label><input type="text" id="signup-nome" placeholder="Seu nome"></div>
      <div class="field"><label>E-mail</label><input type="email" id="signup-email" placeholder="voce@email.com"></div>
      <div class="field"><label>Senha</label><input type="password" id="signup-pass" placeholder="Mínimo 6 caracteres"></div>
      <div class="auth-actions">
        <button class="btn btn-primary btn-block" onclick="doSignup()">Criar conta</button>
      </div>
      <div class="auth-switch">Já tem conta? <button onclick="showView('login')">Entrar</button></div>
    </div>

    <div id="forgot-view" class="hidden">
      <div class="auth-title">Recuperar senha</div>
      <div class="auth-sub">Enviaremos um link de redefinição para o seu e-mail.</div>
      <div id="forgot-error"></div>
      <div class="field"><label>E-mail</label><input type="email" id="forgot-email" placeholder="voce@email.com"></div>
      <div class="auth-actions">
        <button class="btn btn-primary btn-block" onclick="doForgot()">Enviar link</button>
        <button class="btn btn-ghost btn-block" onclick="showView('login')">Voltar</button>
      </div>
    </div>
  </div>

  <!-- ================= ONBOARDING ================= -->
  <div id="onboarding-screen" class="screen">
    <div class="ob-progress" id="ob-progress"></div>
    <div class="ob-body" id="ob-body"></div>
    <div class="ob-footer">
      <div class="ob-nav">
        <button class="btn btn-ghost" id="ob-back" onclick="obBack()" style="flex:0 0 90px;">Voltar</button>
        <button class="btn btn-primary btn-block" id="ob-next" onclick="obNext()">Continuar</button>
      </div>
    </div>
  </div>

  <!-- ================= MAIN APP ================= -->
  <div id="main-app" class="hidden">

    <!-- INÍCIO -->
    <div class="screen active" id="screen-inicio">
      <div class="app-header">
        <div class="header-greet"><div class="eyebrow" id="hi-date"></div><h1 id="hi-name">Olá 👋</h1></div>
        <div class="header-icons">
          <div class="streak-pill">🔥 <span id="hi-streak">0</span></div>
          <button class="icon-btn" onclick="openCoach()">🤖</button>
          <button class="icon-btn" onclick="openScreen('perfil')">👤</button>
        </div>
      </div>
      <div class="content" id="inicio-content"></div>
    </div>

    <!-- TREINO -->
    <div class="screen" id="screen-treino">
      <div class="app-header">
        <div class="header-greet"><div class="eyebrow">Hoje</div><h1>Treino</h1></div>
        <div class="header-icons"><button class="icon-btn" onclick="openScreen('perfil')">👤</button></div>
      </div>
      <div class="content" id="treino-content"></div>
    </div>

    <!-- DIÁRIO -->
    <div class="screen" id="screen-diario">
      <div class="app-header">
        <div class="header-greet"><div class="eyebrow">Alimentação</div><h1>Diário</h1></div>
        <div class="header-icons"><button class="icon-btn" onclick="openScreen('perfil')">👤</button></div>
      </div>
      <div class="content" id="diario-content"></div>
    </div>

    <!-- RECEITAS -->
    <div class="screen" id="screen-receitas">
      <div class="app-header">
        <div class="header-greet"><div class="eyebrow">Sugestões</div><h1>Receitas</h1></div>
        <div class="header-icons"><button class="icon-btn" onclick="openScreen('perfil')">👤</button></div>
      </div>
      <div class="content" id="receitas-content"></div>
    </div>

    <!-- EVOLUÇÃO -->
    <div class="screen" id="screen-evolucao">
      <div class="app-header">
        <div class="header-greet"><div class="eyebrow">Progresso</div><h1>Evolução</h1></div>
        <div class="header-icons"><button class="icon-btn" onclick="openScreen('perfil')">👤</button></div>
      </div>
      <div class="content" id="evolucao-content"></div>
    </div>

    <!-- PERFIL -->
    <div class="screen" id="screen-perfil">
      <div class="app-header">
        <div class="header-greet"><div class="eyebrow">Sua conta</div><h1>Perfil</h1></div>
        <div class="header-icons"><button class="icon-btn" onclick="backFromPerfil()">✕</button></div>
      </div>
      <div class="content" id="perfil-content"></div>
    </div>

    <div id="bottom-nav">
      <button class="nav-item active" data-tab="inicio" onclick="switchTab('inicio')"><span class="ic">🏠</span>Início</button>
      <button class="nav-item" data-tab="treino" onclick="switchTab('treino')"><span class="ic">🏋️</span>Treino</button>
      <button class="nav-fab" onclick="openQuickAdd()">+</button>
      <button class="nav-item" data-tab="diario" onclick="switchTab('diario')"><span class="ic">🍽️</span>Diário</button>
      <button class="nav-item" data-tab="receitas" onclick="switchTab('receitas')"><span class="ic">📖</span>Receitas</button>
    </div>
    <div id="bottom-nav-2" style="position:fixed; left:50%; transform:translateX(-50%); bottom:78px; width:calc(100% - 32px); max-width:428px; display:flex; justify-content:center; z-index:19;">
      <button class="nav-item" data-tab="evolucao" onclick="switchTab('evolucao')" style="background:rgba(27,29,40,.92); backdrop-filter:blur(14px); border:1px solid var(--border-soft); border-radius:100px; padding:6px 16px;"><span class="ic">📈</span>Evolução</button>
    </div>
  </div>

</div>

<!-- ================= OVERLAYS ================= -->
<div class="overlay" id="quickadd-overlay" onclick="if(event.target===this)closeOverlay('quickadd-overlay')">
  <div class="sheet">
    <div class="sheet-handle"></div>
    <div class="sheet-title">Ação rápida</div>
    <div class="sheet-sub">O que você quer registrar agora?</div>
    <div style="display:flex; flex-direction:column; gap:10px;">
